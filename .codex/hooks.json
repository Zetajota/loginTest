{
  "description": "Bloquea los intentos del agente de hacer push si falla la suite o la sintaxis del perfil.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/hooks/pre_push.mjs\"",
            "commandWindows": "node \"$(git rev-parse --show-toplevel)/hooks/pre_push.mjs\"",
            "timeout": 60,
            "statusMessage": "Validando pruebas antes del push"
          }
        ]
      }
    ]
  }
}
